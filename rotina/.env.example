# LOCAL: copie para .env.local e use somente o projeto Development.
# VERCEL: configure valores do novo projeto Production apenas no ambiente Production.
# Nunca copie .env.local para o deploy. Todos os valores abaixo são placeholders.
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Opcional: origem canônica HTTPS para metadata, ex.: https://your-app.vercel.app.
# Em Vercel, se vazio, usa VERCEL_PROJECT_PRODUCTION_URL ou VERCEL_URL.
# Cadastro/reset usam a origem real do navegador, autorizada no Supabase Auth.
NEXT_PUBLIC_SITE_URL=

# Exclusão definitiva: segredo administrativo do MESMO projeto, apenas no servidor.
# Em Vercel: Production, tipo Secret. Nunca NEXT_PUBLIC, commit, chat ou logs.
SUPABASE_SECRET_KEY=

# SOMENTE LOCAL. NÃO cadastrar DEV_* no Vercel, nem em Preview.
# Requer CLI Supabase já autenticado no Rotina - Desenvolvimento. Sem service_role.
DEV_DATA_CLEANUP_ENABLED=false
DEV_DATA_CLEANUP_ALLOW_EXECUTE=false
